
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "wildlands-multiplayer",
  "main": "server.js",
  "compatibility_date": "2026-10-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "WildlandsRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WildlandsRoom"]
    }
  ]
}
